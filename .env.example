# youtube-radar — contrato de nomes de variável.
# Copie para `.env` e preencha. O `.env` é ignorado pelo git; este arquivo não.
#
# Regra de precedência, herdada do projeto irmão: a leitura usa `setdefault`, então
# **a primeira ocorrência de uma chave é a que vale** e o que já estava exportado no
# shell ganha do arquivo. Chave repetida aqui é defeito, não estilo.

# ------------------------------------------------------------------ Discord

# Token do bot. Sem ele, só os comandos offline funcionam.
DISCORD_TOKEN=

# Canal de onde o radar lê os links de canal postados.
# Recomendação: um canal **dedicado** (ex.: um `#canais`), e não o canal de captura
# do discord-link-brain. Os dois usam o mesmo bot, e o campo `me` das reações do
# Discord significa "este usuário-bot", não "este processo": se os vocabulários de
# emoji encostarem, um link some do vault do outro projeto em silêncio.
YTR_CANAL_ENTRADA=

# Canal onde o radar avisa e publica o digest.
# **Não tem padrão de propósito.** Vazio, o notificador recusa subir e nomeia esta
# variável. Cair no canal de captura encheria o arquivo de ruído de bot.
YTR_CANAL_AVISO=

# Quem pode cadastrar canal, por id de usuário do Discord, separado por vírgula.
# Vazio = qualquer um que escreva no canal de entrada.
YTR_DONOS=

# 0 = não posta nada, só diz o que postaria. Padrão 0 de propósito: arquivo escrito
# errado se corrige, mensagem que um humano leu não.
YTR_POST_ENABLED=0

# ------------------------------------------------------------------ marcas

# Vocabulário de emoji do radar. Tem de ser **disjunto** do vocabulário do
# discord-link-brain (✅ 📚 do sync, 💬 ⏳ ❌ do responder) — há um teste que falha
# se encostar. Ver docs/VENDORADO.md.
YTR_EMOJI_CADASTRADO=📡
YTR_EMOJI_REPETIDO=🔁
YTR_EMOJI_VIDEO=🎬
YTR_EMOJI_ERRO=⛔

# ------------------------------------------------------------------ ciclo

# Piso da cadência, em segundos. O feed declara `cache-control: max-age=900` em todos
# os canais medidos, então buscar mais cedo compra uma resposta idêntica.
YTR_PISO_SEGUNDOS=900

# Recuo para canal sem vídeo novo há muitos dias (heurística, não medição).
YTR_RECUO_LENTO=1
YTR_RECUO_LENTO_DIAS=7
YTR_RECUO_LENTO_SEGUNDOS=3600

# Teto de avisos por ciclo e por canal. Canal que solta 8 vídeos de uma vez rende
# `YTR_MAX_AVISOS_CANAL` avisos e uma linha dizendo quantos ficaram de fora.
YTR_MAX_AVISOS_CICLO=10
YTR_MAX_AVISOS_CANAL=3

# Avisar Shorts? O RSS identifica Short de graça, pelo `/shorts/` no href do <link>.
YTR_AVISAR_SHORTS=0

# Quantos ids de vídeo já avisados guardar por canal. O feed nunca traz mais de 15,
# então 50 é 3x de folga e limita o tamanho do arquivo.
YTR_LEMBRAR_IDS=50

# Pool 2: em vez de descartar um Short suprimido do aviso individual, guarda como
# candidato do digest (§D7) — não gasta rede extra, o feed já foi buscado no ciclo.
YTR_POOL2_ATIVO=1
YTR_POOL2_JANELA_DIAS=3

# ------------------------------------------------------------------ gosto

# Vault do Obsidian, lido **somente para leitura**. O radar nunca escreve nele.
OBSIDIAN_VAULT=~/Documents/Obsidian/vault

# Pesos do ranqueamento. Estão aqui porque são chute inicial: não há dado para
# calibrar antes de existirem 👍/👎 de verdade.
YTR_PESO_CANAL=5.0
YTR_PESO_TAG=2.0
YTR_PESO_LEXICO=1.0
YTR_PESO_ENGAJAMENTO=1.5
YTR_PESO_RECENCIA=1.0
YTR_PESO_POLEGAR_BAIXO=8.0

# Orçamento de prompt para o corpus de gosto, em caracteres. O `doctor` imprime o
# tamanho contado do corpus contra este número — é o gatilho para embeddings.
YTR_CORPUS_MAX_CHARS=120000

# ------------------------------------------------------------------ digest

# Hora do digest diário, HH:MM no fuso de TZ.
YTR_DIGEST_AT=08:00

# Quantos candidatos o digest publica, e o teto por canal (diversidade).
YTR_DIGEST_ITENS=4
YTR_DIGEST_POR_CANAL=1

# Janela para reler reações de mensagens já publicadas, em dias.
YTR_JANELA_FEEDBACK_DIAS=7

# ------------------------------------------------------------------ modelo

# none | claude-cli | codex-cli (anthropic ainda não está implementado — escolher
# isto sai com erro claro, não com silêncio)
# `none` é o padrão e o digest sai igual sem modelo — o modelo **narra** o ranking
# que as regras já decidiram (Fase 8), nunca escolhe.
YTR_LLM_BACKEND=none

# Caminho do binário, se não estiver no PATH do container. Mesmo nome de variável do
# discord-link-brain de propósito — os dois montam o mesmo `~/.claude`/`~/.codex`.
CLAUDE_BIN=claude
CODEX_BIN=codex

# Segundos antes de desistir da chamada. Bem menor que o do discord-link-brain (900s):
# o digest só pede 1-3 frases sobre uma lista já pronta, não uma síntese de verdade.
YTR_LLM_TIMEOUT=60

# Teto duro de chamadas de modelo por dia. O login local é recurso escasso e o
# discord-link-brain já o disputa com três consumidores.
YTR_LLM_MAX_DIA=1

# Resumo por vídeo feito por modelo. Desligado: rodando de 15 em 15 minutos, isto
# comeria a janela de quota que o outro projeto usa para a classificação diária.
YTR_RESUMO_LLM=0

# Ledger de quota compartilhado entre projetos, opcional dos dois lados.
# Vazio = sem contenção entre projetos (a contenção fica só por agendamento).
LLM_BUDGET_DIR=

# ------------------------------------------------------------------ máquina

# Fuso da máquina. Padrão UTC: fuso de um lugar específico embutido faz o sistema
# mentir a hora para quem não mora lá — e mentir plausivelmente, que é o pior tipo.
TZ=UTC

# Onde mora o estado local.
YTR_STATE_DIR=.state

# Tolerância do HEALTHCHECK, em segundos, sem heartbeat novo.
YTR_HEALTH_TOLERANCE=3600
